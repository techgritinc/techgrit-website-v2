# Copy this file to `.env` and fill in the values for your environment.
# `.env` itself is gitignored — never commit real values.

# Base URL of the Strapi CMS that all page content is fetched from.
# Required: every route is server-rendered and reads this at request time.
# Note that `fetchCms` fails soft (returns null) when this is missing or the CMS
# is unreachable, so pages render empty sections instead of throwing — a wrong
# value here is easy to miss locally.
# Local Strapi default: http://localhost:1337
CMS_API_URL=http://localhost:1337

# Google Analytics 4 measurement ID.
# Optional: analytics is skipped entirely when this is unset.
# Client-side (NEXT_PUBLIC_ prefix) and only fires once cookie consent is granted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
