# Copy this file to `.env` and fill in the values for your environment.
# `.env` itself is gitignored — never commit real values.

# Base URL of the Strapi CMS that all page content is fetched from.
# Required: every route is server-rendered and reads this at request time.
# Note that `fetchCms` fails soft (returns null) when this is missing or the CMS
# is unreachable, so pages render empty sections instead of throwing — a wrong
# value here is easy to miss locally.
# Local Strapi default: http://localhost:1337
CMS_API_URL=http://localhost:1337

# Google Analytics 4 measurement ID.
# Optional: analytics is skipped entirely when this is unset.
# Client-side (NEXT_PUBLIC_ prefix) and only fires once cookie consent is granted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Graph (Microsoft 365).
# Needs an Entra ID app registration with the APPLICATION permission Mail.Send (admin consent).
# Required by the deploy workflows. If any is missing at runtime, the e-mail is skipped
# (logged) and the application is still saved in the CMS.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox the e-mail is sent from (must exist in the tenant)
MS_GRAPH_SENDER=support@techgrit.com
# Who receives applications (comma-separated allowed). Required, no default in code.
# Prefer a different mailbox from MS_GRAPH_SENDER, so applications are not mixed in with
# the sender's own Sent Items.
CAREERS_NOTIFY_TO=careers@techgrit.com

# Careers application tuning (all required, server-only — never NEXT_PUBLIC_).
# There are no defaults in code: a missing, 0 or non-numeric value makes the submission
# fail and logs an error, and the deploy workflows refuse to deploy without them.
# Rate-limit window in ms (example: 10 minutes).
CAREERS_RATE_WINDOW_MS=600000
# Max applications per client IP per window.
CAREERS_MAX_PER_IP=5
# Max applications across all IPs per window.
CAREERS_MAX_GLOBAL=60
# Largest resume (bytes) attached to the HR e-mail; bigger files are linked instead.
# Capped at 2621440 (2.5 MiB) in code: higher values are ignored, because Microsoft
# Graph rejects mails over ~4 MB once base64 is added.
CAREERS_MAX_ATTACHMENT_BYTES=2621440
