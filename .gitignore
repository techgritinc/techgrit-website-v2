# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# local only, do not push
# Ignore .claude contents by default (personal settings, session state)...
.claude/*
# ...but track shared, team-wide project skills vendored into the repo
# (see .specify/memory/constitution.md Principle VI).
!.claude/skills/
raw-files
raw-files-v2

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env
